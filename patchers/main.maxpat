				}

			}
, 			{
				"box" : 				{
					"code" : "const ClipStateUpdater = require(\"ClipStateUpdater\");\r\n\r\nthis.inlets = 4;\r\nthis.outlets = 4;\r\n\r\nconst state = new Dict(\"state\");\r\nconst ctqBeats = new Dict(\"ctqBeats\");\r\nconst colours = new Dict(\"colours\");\r\n\r\nconst clipStateUpdater = new ClipStateUpdater({ \r\n\tstate, colours, ctqBeats \r\n});\r\n\r\nlet bars = null;\r\nlet beats = null;\r\nlet units = null;\r\n\r\nconst isRewound = () => bars === 1 && beats === 1 && units === 0;\r\n\r\nfunction msg_int(value) {\r\n\tswitch (inlet) {\r\n\t\tcase 0:\r\n\t\t\tpost(`value: ${value}\\n`);\r\n\t\t\tpost(`is rewound? ${isRewound()}\\n`);\r\n\t\t\tif (value === 1 && isRewound()) {\r\n\t\t\t\tclipStateUpdater.fire(outlet);\r\n\t\t\t} \r\n\t\t\toutlet(3, value);\r\n\t\t\tbreak;\r\n\t\tcase 1:\r\n\t\t\tbars = value;\r\n\t\t\tbreak;\r\n\t\tcase 2:\r\n\t\t\tbeats = value;\r\n\t\t\tbreak;\r\n\t\tdefault:\r\n\t}\r\n}\r\n\r\nfunction msg_float(value) {\r\n\tswitch (inlet) {\r\n\t\tcase 3:\r\n\t\t\tunits = value;\r\n\t\t\tbreak;\r\n\t\tdefault:\r\n\t}\r\n}",
					"filename" : "none",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 10.0,
					"id" : "obj-254",
					"maxclass" : "v8.codebox",
					"numinlets" : 4,
					"numoutlets" : 4,
					"outlettype" : [ "", "", "", "" ],
					"patching_rect" : [ 628.0, 418.0, 490.0, 510.0 ],
					"saved_object_attributes" : 					{
						"parameter_enable" : 0
					}

				}

			}
