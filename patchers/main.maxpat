, 			{
				"box" : 				{
					"code" : "const BeatLamps = require(\"BeatLamps\");\r\n\r\nthis.inlets = 3;\r\nthis.outlets = 9;\r\n\r\nconst ctqBeats = new Dict(\"ctqBeats\");\r\n\r\nconst beatLamps = new BeatLamps({ ctqBeats, outlet });\r\n\r\nfunction msg_int(value) {\r\n\tswitch (inlet) {\r\n\t\tcase 0:\r\n\t\t\tbeatLamps.bar = value;\r\n\r\n\t\t\t// leftmost inlet, which receives bars, it hot,\r\n\t\t\t// so it triggers update of lamps\r\n\t\t\tbeatLamps.update(outlet);\r\n\t\t\tbreak;\r\n\t\t\t\r\n\t\tcase 1:\r\n\t\t\tbeatLamps.beat = value;\r\n\t\t\tbreak;\r\n\t\t\t\r\n\t\tcase 2:\r\n\t\t\tbeatLamps.ctq = value;\r\n\t\t\tbreak;\r\n\t\t\t\r\n\t\tdefault:\r\n\t}\r\n}",
					"filename" : "none",
					"fontface" : 0,
