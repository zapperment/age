, 			{
				"box" : 				{
					"code" : "const launchpadIndexToPadId = require(\"launchpadIndexToPadId\");\r\n\r\nthis.inlets = 1;\r\nthis.outlets = 1;\r\n\r\nfunction anything(...bytes) {\r\n\tif (bytes[2] === 0) {\r\n\t\t// zero means pad up; ignore\r\n\t\treturn;\r\n\t}\r\n\tconst launchpadIndex = bytes[1];\r\n\tconst padId = launchpadIndexToPadId(launchpadIndex);\r\n\tpost(`Pad #${padId} was hit (Launchpad index ${launchpadIndex})\\n`);\r\n\toutlet(0, padId);\r\n}",
					"filename" : "none",
