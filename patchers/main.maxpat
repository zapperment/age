, 			{
				"box" : 				{
					"code" : "const ClipStateUpdater = require(\"ClipStateUpdater\");\r\n\r\nthis.inlets = 4;\r\nthis.outlets = 3;\r\n\r\nconst ctqBeats = new Dict(\"ctqBeats\");\r\nconst state = new Dict(\"state\");\r\nconst colours = new Dict(\"colours\");\r\n\r\n\r\nconst clipStateUpdater = new ClipStateUpdater({ state, colours, ctqBeats });\r\n\r\nfunction msg_float(value) {\r\n\tswitch (inlet) {\r\n\t\tcase 0:\r\n\t\t\tclipStateUpdater.unit = value;\r\n\t\t\t// leftmost inlet, which receives units, it hot,\r\n\t\t\t// so it triggers output\r\n\t\t\tclipStateUpdater.update(outlet);\r\n\t\t\tbreak;\r\n\t\tdefault:\r\n\t}\r\n}\r\n\r\nfunction msg_int(value) {\r\n\tswitch (inlet) {\r\n\t\tcase 1:\r\n\t\t\tclipStateUpdater.bar = value;\r\n\t\t\tbreak;\r\n\t\t\t\r\n\t\tcase 2:\r\n\t\t\tclipStateUpdater.beat = value;\r\n\t\t\tbreak;\r\n\t\t\t\r\n\t\tcase 3:\r\n\t\t\tclipStateUpdater.ctq = value;\r\n\t\t\tbreak;\r\n\t\t\t\r\n\t\tdefault:\r\n\t}\r\n}",
					"filename" : "none",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 10.0,
					"id" : "obj-159",
					"maxclass" : "v8.codebox",
					"numinlets" : 4,
					"numoutlets" : 3,
					"outlettype" : [ "", "", "" ],
					"patching_rect" : [ 3892.0, 782.0, 518.0, 449.0 ],
					"saved_object_attributes" : 					{
						"parameter_enable" : 0
					}
,
					"varname" : "v8_AA[1]"
				}

